// AzhaguThinpandam ecommerce schema
// SQLite notes: no enums (use String + constants in src/lib/constants.ts),
// money stored as integer paise.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  // Customers log in with phone + WhatsApp OTP (no password). Admins log in
  // with email + password. Customer email is optional (asked at checkout for
  // order confirmations).
  email        String?   @unique
  passwordHash String?
  name         String?
  phone        String?   @unique
  role         String    @default("CUSTOMER") // CUSTOMER | ADMIN
  // Staff buy at wholesale cost + ₹5 per packet instead of retail. Deliberately
  // not a role: `role` is pure access control (ADMIN vs everyone else), and a
  // third value would break the admin customers list (filters role = CUSTOMER)
  // and createCustomer (writes CUSTOMER). This is orthogonal to permissions.
  isEmployee   Boolean   @default(false)
  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  cartLines    CartLine[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// One-time login codes delivered over WhatsApp or email (stored hashed,
// short-lived). `phone` holds the identifier: a 10-digit mobile OR a
// lowercased email — the namespaces are disjoint.
model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  tamilName String?
  slug      String    @unique
  image     String?
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String           @id @default(cuid())
  name        String
  tamilName   String?
  slug        String           @unique
  description String
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  isActive    Boolean          @default(true)
  isFeatured  Boolean          @default(false)
  isFlagship  Boolean          @default(false) // hero products pinned to the top of listings
  // Made fresh in batches, so a stock count of 0 must never block a sale: the
  // storefront always shows it as available and checkout skips the stock check.
  // Stock still counts down (and may go negative — units owed) so the ledger
  // and Purchases keep working. Merchandise leaves this off; it really does
  // run out. See src/lib/availability.ts.
  madeToOrder Boolean          @default(false)
  // Which product line this belongs to — see PRODUCT_LINES. Snacks are priced
  // and discounted by weight; merchandise (fridge magnets) is not, so the two
  // are listed separately on the storefront. SQLite has no enums.
  line        String      @default("SNACKS")

  // Pricing rule: wholesale cost + target margin drive variant sale prices
  purchasePricePerKg Int? // paise per kg (wholesale cost)
  profitMarginPct    Float? // e.g. 25 = sell at cost + 25%
  // GST rate (%) included in the sale price. Null falls back to the store
  // default (Setting `default_gst_rate`). Prices are GST-inclusive.
  gstRate     Float?
  images      ProductImage[]
  variants    ProductVariant[]
  reviews     Review[]
  // Denormalised from APPROVED reviews (recomputed on moderation) so listings
  // can show stars without aggregating per card.
  ratingAvg   Float?
  ratingCount Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductVariant {
  id            String          @id @default(cuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  label         String // e.g. "250 g", "500 g", "1 kg"
  price         Int // selling price in paise
  mrp           Int? // strike-through price in paise
  // Actual pack weight in grams. Snack labels ("250 g") parse to this, but
  // merchandise labels ("Single", "Set of 4") don't — without it a magnet
  // weighs nothing and ships free outside Tamil Nadu.
  weightGrams   Int?
  // Per-unit wholesale cost in paise, for items not priced by the kilo.
  // Takes precedence over the product's purchasePricePerKg when set.
  unitCost      Int?
  stock         Int             @default(0)
  sku           String?         @unique
  sortOrder     Int             @default(0)
  isActive      Boolean         @default(true)
  orderItems    OrderItem[]
  purchaseItems PurchaseItem[]
  movements     StockMovement[]
  cartLines     CartLine[]

  @@index([productId])
}

// A logged-in customer's cart, mirrored from the browser on every change.
// The browser copy (localStorage) stays the source of truth while they shop;
// this mirror exists so an abandoned cart is visible in the admin panel with
// a phone number to follow up on. Rows are replaced wholesale per sync, and
// an empty sync (order placed, cart cleared) removes them.
model CartLine {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  qty       Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, variantId])
  @@index([updatedAt])
}

// Customer product reviews. Only verified purchasers can post (enforced in the
// API), and reviews stay PENDING until an admin approves them. Admins can also
// enter reviews on a customer's behalf (WhatsApp feedback) — those have no
// user link (userId null) and are created APPROVED.
model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int // 1..5
  title      String?
  body       String?
  authorName String? // display-name snapshot at submit time
  // Whether the author had actually bought this product when they wrote it —
  // snapshotted here so the storefront's "Verified purchase" badge can't lie.
  // Admin-entered reviews set it true (the admin vouches for the feedback).
  verifiedPurchase Boolean @default(false)
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, userId]) // one review per customer per product (editable)
  @@index([productId, status])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  email       String
  status      String      @default("PENDING") // PENDING | PAID | CONFIRMED | SHIPPED | DELIVERED | CANCELLED
  // shipping address snapshot (kept even if the saved Address changes)
  shipName    String
  shipPhone   String
  shipLine1   String
  shipLine2   String?
  shipCity    String
  shipState   String
  shipPincode String
  subtotal    Int // paise
  discount    Int         @default(0) // paise — bundle/box tier discount
  shippingFee Int // paise
  // Ad-hoc reduction an admin agrees on an unpaid order (WhatsApp haggling).
  // Kept apart from `discount`, which priceOrderLines recomputes from scratch
  // on every reprice and would otherwise wipe it.
  manualDiscount Int     @default(0) // paise
  discountNote   String? // why it was given, e.g. "regular customer"
  // Admin-set delivery charge, overriding the computed one. Null means "use the
  // shipping rules". Kept separate so repricing knows not to recompute it;
  // `shippingFee` above always holds the effective amount charged, so every
  // display and report reads it without knowing about this.
  shippingFeeOverride Int?
  total       Int // paise (subtotal - discount - manualDiscount + shippingFee)
  packingCost Int         @default(0) // paise — internal cost (not charged to customer)
  // What the courier actually charged us, paise. `shippingFee` above is what
  // the customer was charged — the two differ (flat ₹60 collected on a 2 kg
  // parcel that cost ₹120), and the gap is only visible if both are recorded.
  shippingCost Int        @default(0)
  notes       String?
  // Coupon snapshot — set only when a coupon actually applied (beat the box
  // discount). `discount` above holds the winning amount (box vs coupon).
  couponId    String?
  coupon      Coupon?     @relation(fields: [couponId], references: [id])
  couponCode  String?
  redemption  CouponRedemption?
  items       OrderItem[]
  payment     Payment?
  // Browser context captured when the customer placed the order, so the
  // server-side Meta Purchase event can be attributed to them. Payment is
  // confirmed later — by a webhook, or by an admin for a manual UPI order —
  // and neither of those requests carries the customer's browser. Null for
  // admin-entered orders, which never had one.
  clientIp        String?
  clientUserAgent String?
  fbp             String? // _fbp cookie — Meta's browser id
  fbc             String? // _fbc cookie — the click that brought them here
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([status, createdAt])
  @@index([shipPhone])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // snapshots so the order stays intact if products change
  productName   String
  variantLabel  String
  image         String?
  price         Int // unit price in paise at time of order
  qty           Int
  basePackGrams Int? // base packet size for the "N × Ng packets" delivery note
  gstRate       Float? // GST% included in `price`, snapshot at order time (output GST)
  isFreebie     Boolean         @default(false) // ₹0 goodie added by the weight-goodies discount

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String   @unique
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  razorpaySignature String?
  amount            Int // paise
  status            String   @default("CREATED") // CREATED | CAPTURED | FAILED
  method            String? // upi | card | netbanking | wallet
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Setting {
  key   String @id
  value String
}

// Discount codes entered at checkout. The applied discount is whichever is
// larger: this coupon or the weight-based box discount (never both).
model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique // stored uppercase
  type             String // "PERCENT" | "FLAT"
  value            Int // PERCENT: whole percent (10 = 10%); FLAT: paise off
  maxDiscount      Int? // paise — optional cap for PERCENT coupons
  minOrder         Int                @default(0) // paise — minimum subtotal to qualify
  perCustomerLimit Int                @default(1) // max redemptions per phone number
  isActive         Boolean            @default(true)
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  redemptions      CouponRedemption[]
  orders           Order[]
}

// One row per successful redemption (created when the order is paid), so the
// per-customer limit can be enforced by phone number.
model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  phone     String
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([couponId, phone])
}

// ---- Accounting (admin-only) ----

// Wholesale vendors we buy stock from. `owed` is derived, not stored:
// Σ(purchase totals) − Σ(payments) for this supplier.
model Supplier {
  id        String            @id @default(cuid())
  name      String
  gstin     String? // supplier's GST registration number
  phone     String?
  email     String?
  address   String?
  gstRate   Float? // default GST% on this supplier's goods (fills the purchase form)
  notes     String?
  isActive  Boolean           @default(true)
  purchases Purchase[]
  payments  SupplierPayment[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

// A payment made to a supplier (reduces what we owe them). Lump sums can cover
// several invoices, so payments are tracked against the supplier, not a purchase.
model SupplierPayment {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  date       DateTime
  amount     Int // paise
  method     String? // Cash | UPI | Bank transfer | Cheque | Other
  reference  String? // txn id / cheque no
  notes      String?
  createdAt  DateTime @default(now())

  @@index([supplierId, date])
}

// Stock bought from a supplier — counted as cost of goods in the P&L.
model Purchase {
  id          String         @id @default(cuid())
  date        DateTime
  // `supplier` is a denormalised name snapshot (kept even if the Supplier row
  // is deleted); `supplierId` links to the Supplier for the payables ledger.
  supplier    String
  supplierId  String?
  supplierRef Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoiceNo   String?
  notes       String?
  gstRate     Float          @default(0) // GST% included in `total` (input GST)
  total       Int // paise (sum of item amounts, GST-inclusive)
  // Courier/lorry charges the supplier paid on our behalf and billed with the
  // invoice — owed to them like the goods, but kept OUT of `total` so the
  // input-GST math (rate backed out of `total`) never taxes freight, and out
  // of Expenses so it isn't counted twice. Zero when we paid the transporter
  // ourselves (that stays an Expense, as before).
  transportCharge Int        @default(0) // paise
  // UNPAID | PAID (PURCHASE_STATUSES) — a per-invoice marker. The authoritative
  // supplier balance stays Σ(purchases) − Σ(SupplierPayment); marking an invoice
  // paid offers to record that payment so the two agree.
  status      String         @default("UNPAID")
  items       PurchaseItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([supplierId])
  @@index([date])
}

model PurchaseItem {
  id          String          @id @default(cuid())
  purchaseId  String
  purchase    Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  description String // e.g. "Kadalai Mittai — 10 kg"
  qty         Float // in kg or units
  unitCost    Int // paise per kg/unit
  amount      Int // paise (qty × unitCost, rounded)
  // Optional link into inventory: receiving this line adds `packs` to a variant
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  packs       Int?

  @@index([purchaseId])
  @@index([variantId])
}

// Audit trail for every stock change (packs in/out per variant)
model StockMovement {
  id           String         @id @default(cuid())
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta        Int // + in, − out
  balanceAfter Int? // stock right after this movement
  reason       String // SALE | CANCEL_RESTOCK | ADJUSTMENT | PURCHASE_IN
  reference    String? // order number / purchase invoice
  note         String?
  createdAt    DateTime       @default(now())

  @@index([variantId, createdAt])
}

// Operating costs: packing materials, transport, marketing…
model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  category    String
  description String?
  amount      Int // paise
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}
