# Caddy reverse proxy with automatic HTTPS (Let's Encrypt).
# DOMAIN comes from the environment (set it in .env next to docker-compose.yml).

# www points at this server in DNS, so it must be served too — without this
# block Caddy has no certificate for it and the TLS handshake fails outright
# (browsers just show "can't open this site"). Redirect to the bare domain so
# there is a single canonical URL.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode gzip

	# Access log — one JSON object per request with the client IP, path, status,
	# duration and user agent. Caddy is the edge here (nothing in front of it),
	# so remote_ip is the real visitor, not a proxy.
	# Rolls at 10MB, keeps 10 files / 30 days. Readable on the host at
	# ./logs/caddy/access.log — run deploy/traffic.sh for the summaries.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 720h
			# World-readable: the app container's non-root user reads these for
			# /admin/traffic. Applies to new files only — chmod any existing ones.
			mode 644
		}
		format json
	}

	# Long cache for build assets (they're content-hashed)
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy app:3000
}

# MyTodo — separate app, separate repo (/opt/mytodo), separate compose file. It
# joins this stack's network so Caddy can reach the container by name; nothing
# about it is coupled to the shop beyond this block.
#
# The hostname is baked in as the default so this works without any .env entry;
# MYTODO_DOMAIN in .env next to docker-compose.yml overrides it if it ever moves.
# A default also matters for safety: an empty site address is a config error
# that would take this whole file — and the shop with it — down.
{$MYTODO_DOMAIN:todo.tekspear.com} {
	encode gzip

	# The PWA's service worker needs a secure context, which the automatic
	# Let's Encrypt cert on this block provides.
	reverse_proxy mytodo:8080
}
