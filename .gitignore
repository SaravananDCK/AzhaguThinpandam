# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# Both patterns matter: ".env*" catches ".env.local", "*.env" catches copies
# like "config - Copy.env" that a file manager or editor leaves behind — those
# hold real secrets and would otherwise be swept up by "git add -A".
.env*
*.env
!.env.example

# runtime data on the server (docker volumes)
/data
/backups
/logs

# deploy package (regenerate with scripts/make-publish.ps1)
azhagu-publish.zip

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# admin-uploaded images (runtime data)
/uploads

# sqlite
prisma/dev.db*
prisma/*.db*

# local design source files (exported assets live in public/)
/*.cdr
/PriceList*.png
/WelcomeBanner.png
/Backup_of_*

# Razorpay key exports from the dashboard — these hold key_secret. Keep them
# out of the repo entirely; the values belong in .env only.
rzp*.csv

# Local scratch: throwaway scripts and db dumps kept at the repo root
/_*

# Claude Code's local session settings
/.claude
